COMPOSE_PROJECT_NAME=yolo-detection-framework

POSTGRES_DB=yolo
POSTGRES_USER=yolo
POSTGRES_PASSWORD=yolo_dev_password

DATABASE_URL=postgresql+asyncpg://yolo:yolo_dev_password@postgres:5432/yolo
REDIS_URL=redis://redis:6379/0
STORAGE_ROOT=/app/storage

JOB_STREAM=yolo:jobs
JOB_CONSUMER_GROUP=yolo-workers

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
MAX_UPLOAD_MB=512

YOLO_CONFIDENCE=0.35

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
