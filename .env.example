COMPOSE_PROJECT_NAME=yolo-detection-framework

POSTGRES_DB=yolo
POSTGRES_USER=yolo
POSTGRES_PASSWORD=change_me_in_prod

REDIS_PASSWORD=change_me_in_prod

DATABASE_URL=postgresql+asyncpg://yolo:change_me_in_prod@postgres:5432/yolo
REDIS_URL=redis://:change_me_in_prod@redis:6379/0
STORAGE_ROOT=/app/storage

JOB_STREAM=yolo:jobs
JOB_CONSUMER_GROUP=yolo-workers

AUTH_ENABLED=true
API_KEYS=devkey1,devkey2
ALLOWED_MODELS=["best.pt"]

CORS_ORIGINS=["http://localhost","http://localhost:3000","http://127.0.0.1:3000"]
MAX_UPLOAD_MB=512

QUOTA_JOBS_PER_DAY=200
QUOTA_STORAGE_MB=10240
QUOTA_CONCURRENT_JOBS=3
QUEUE_MAX_DEPTH=500

YOLO_CONFIDENCE=0.35
YOLO_DEVICE=auto

NEXT_PUBLIC_API_BASE_URL=http://localhost/api
NEXT_PUBLIC_API_KEY=devkey1
